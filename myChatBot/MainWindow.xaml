<Window x:Class="myChatBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:myChatBot"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Background="Blue"/>
        <Border Grid.Column="1" Grid.RowSpan="2" Background="Black"/>

        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
            <Border Width="485" Height="47" HorizontalAlignment="Left" Background="White" CornerRadius="20">
                <TextBox x:Name="message" Width="460" Height="47" HorizontalAlignment="Center" BorderThickness="0" Background="Transparent"/>
            </Border>
            <Button Background="Transparent" BorderThickness="0" Click="sendrequest" IsDefault="True">
                <Image Source="/image/send (1).png" Width="47" Height="47" HorizontalAlignment="Right"/>
            </Button>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Column="1" Grid.Row="0">
            <StackPanel x:Name="displaying" Orientation="Vertical">
                <Border Background="Transparent" Width="550" Height="350" HorizontalAlignment="Left" CornerRadius="7" BorderThickness="7" BorderBrush="Transparent">
                    <StackPanel>
                        <TextBlock x:Name="myArt" Width="550" Height="300" FontSize="8" TextWrapping="Wrap" FontFamily="Consolas" Padding="5" Foreground="Blue"/>
                        <TextBox Text="hello welcome to the cybersecurity awareness bot." Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" Foreground="White"/>
                        <TextBlock Text="I'm here to help you to stay safe online. what is your name?" Foreground="White"/>
                    </StackPanel>
                </Border>

            </StackPanel>


        </ScrollViewer>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <Border Background="Blue" BorderThickness="2" BorderBrush="White">
                <Image Source="/image/WhatsApp Image 2026-05-25 at 11.51.19.jpeg"  Width="200" Height="300"/>
            </Border>
        </StackPanel>

        <StackPanel x:Name="QuizsDisplay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0">

            <StackPanel x:Name="Question1">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUIZS" Foreground="Yellow" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 1" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What is the primary difference between Authentication and Authorization?"   Foreground="White" />
                <RadioButton x:Name="Question1A" Content="A. Authentication is for the user, Authorization is for Devices" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question1B" Content="B. Authentication verifies identity, Authorization determines permissions" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question1C" Content="C. Authentication is more secure than Authorization" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question1D" Content="D. They are the same thing" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>

            <StackPanel x:Name="Question2" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 2" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="Which of the following is the Strong Password" Foreground="White"/>
                <RadioButton x:Name="Question2A" Content="A.P@wwOrd123" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question2B" Content="B. correct-horse-battery-staple-2025" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question2C" Content="C. MyBirthday2005!" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question2D" Content="D. sandile123" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question3" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 3" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="You receive an email from your-bank@secure-login.com " Foreground="White"/>
                <TextBlock Text="asking you to verify your account. What should you do?" Foreground="White"/>
                <RadioButton x:Name="Question3A" Content="A. Click the link and verify immediately" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question3B" Content="B. Reply with your account details" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question3C" Content="C. Hover over the link, check the URL, then call your bank directly using a known number" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question3D" Content="D. Forward it to friends to check" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>

            <StackPanel x:Name="Question4" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 4" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="hat type of malware encrypts your files and demands payment for decryption?" Foreground="White"/>

                <RadioButton x:Name="Question4A" Content="A. Virus" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question4B" Content="B. Worm" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question4C" Content="C. Ransomware" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question4D" Content="D. Spyware" Foreground="Blue"  Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question5" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 5" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What does HTTPS provide that HTTP does not?" Foreground="White"/>

                <RadioButton x:Name="Question5A" Content="A. Faster loading times" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question5B" Content="B. Better SEO ranking" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question5C" Content="C. End-to-end encryption of data in transit" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question5D" Content="D. Automatic backups" Foreground="Blue"  Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question6" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 6" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="Which form of Multi-Factor Authentication is LEAST secure?" Foreground="White"/>

                <RadioButton x:Name="Question6A" Content="A. Hardware security key (YubiKey)" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question6B" Content="B. Authenticator app (Google Authenticator)" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question6C" Content="C. SMS text message codes" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question6D" Content="D. Push notification with number matching" Foreground="Blue"  Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question7" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 7" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="A person calls claiming to be from IT support, asking for " Foreground="White"/>
                <TextBlock Text="your password to fix an urgent issue. This is an example of:"/>
                <RadioButton x:Name="Question7A" Content="A. Phishing" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question7B" Content="B. Vishing (Voice Phishing)" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question7C" Content="C. Smishing" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question7D" Content="D. Ethical hacking" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question8" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 8" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What is the 3-2-1 backup rule?" Foreground="White"/>

                <RadioButton x:Name="Question8A" Content="A. 3 passwords, 2 devices, 1 hour" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question8B" Content="B. 3 copies of data, 2 different media types, 1 offsite copy" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question8C" Content="C. 3 firewalls, 2 networks, 1 VPN" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question8D" Content="D. 3 antivirus, 2 scans daily, 1 report" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question9" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 9" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What is a DDoS attack?" Foreground="White"/>

                <RadioButton x:Name="Question9A" Content="A. Deploying malicious software to steal data" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question9B" Content="B. Overwhelming a server with traffic to make it unavailable" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question9C" Content="C. Gaining unauthorized access to a database" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question9D" Content="D. Encrypting files for ransom" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question10" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 10" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What is the primary benefit of using a password manager?" Foreground="White"/>

                <RadioButton x:Name="Question10A" Content="A. It automatically remembers all passwords for you" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question10B" Content="B. It generates and stores unique, complex passwords for each site" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question10C" Content="C. It can be used without a master password" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question10D" Content="D. It stores passwords in plain text for convenience" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>

            </StackPanel>
            <StackPanel x:Name="Question11" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 11" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="Which malware type disguises itself as legitimate software?" Foreground="White"/>

                <RadioButton x:Name="Question11A" Content="A. Worm" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question11B" Content="B. Adware" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question11C" Content="C. Trojan Horse" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question11D" Content="D. Keylogger" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question12" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 12" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="The first step after discovering a data breach is to immediately notify all customers." Foreground="White"/>

                <RadioButton x:Name="Question12A" Content="TRUE" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question12B" Content="FALSE" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question13" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 13" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What is a digital footprint?" Foreground="White"/>

                <RadioButton x:Name="Question13A" Content="A. The physical trail of devices on a network" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question13B" Content="B. The data trail you leave online through activity, posts, and cookies" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question13C" Content="C. A type of malware that follows your keystrokes" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question13D" Content="D. A security certificate for websites" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question14" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 14" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="Statement: Creating a sense of urgency or fear is a common " Foreground="White"/>
                <TextBlock Text=" red flag of a social engineering attack." Foreground="White"/>
                <RadioButton x:Name="Question14A" Content="TRUE" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question14B" Content="FALSE" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question15" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 15" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What is the purpose of encryption?" Foreground="White"/>

                <RadioButton x:Name="Question15A" Content="A. To make data load faster" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question15B" Content="B. To compress data for storage" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question15C" Content="C. To convert data into unreadable format to protect confidentiality" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question15D" Content="D. To permanently delete sensitive information" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question16" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 16" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="Statement: A firewall's primary function is to speed up internet connections." Foreground="White"/>

                <RadioButton x:Name="Question16A" Content="TRUE" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question16B" Content="FALSE" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>
            <StackPanel x:Name="Question17" Visibility="Collapsed">
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="QUESTION 17" Foreground="Green" HorizontalAlignment="Center"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
                <TextBlock Text="What is a botnet?" Foreground="White"/>

                <RadioButton x:Name="Question17A" Content="A. A single powerful server used for hacking" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question17B" Content="B. A network of infected devices controlled remotely by attackers" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question17C" Content="C.  A type of firewall protection" Foreground="Blue" Checked="RadioButton_Checked"/>
                <RadioButton x:Name="Question17D" Content="D. A password management tool" Foreground="Blue" Checked="RadioButton_Checked"/>
                <TextBlock Text="=============================================================================" Foreground="SkyBlue"/>
            </StackPanel>

        </StackPanel>

        <DataGrid Grid.Row="0"
               Grid.Column="1"
               Visibility="Collapsed"
              x:Name="TaskGrid"
               Width="550" Height="350"
               Background="Black"
              AutoGenerateColumns="True"/>

    </Grid>
</Window>
